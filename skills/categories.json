{
  "loadout": {
    "max_skills": 10,
    "max_tokens": 2000
  },
  "provisional": {
    "max_skill_tokens": 800,
    "max_description_chars": 200
  },
  "thresholds": {
    "min_quality_lift_pp": 10,
    "max_token_overhead_pct": 20,
    "micro_min_wins_or_ties": 3,
    "micro_max_task_loss": 1,
    "strict_alpha": 0.05
  },
  "context_load": {
    "reference_windows": [128000, 200000, 1000000],
    "share_warn_pct": 10,
    "growth_warn_pct": 20,
    "duplicate_similarity": 0.5,
    "mcp_tokens_per_server_estimate": 1500
  },
  "micro_eval": {
    "generator": "gpt-5.4-mini",
    "judge": "gpt-5.2-chat",
    "concurrency": 8,
    "baseline_tokens_per_call": 50000,
    "models": {
      "gpt-5.4-mini": {"max_completion_tokens": 1200, "reasoning_effort": "low"},
      "gpt-5.2-chat": {"max_completion_tokens": 600}
    }
  },
  "categories": {
    "ux": {
      "skill_pattern": "\\b(ux|ui|user experience|usability|accessib\\w*|wcag|design system|interaction design|visual design)\\b",
      "task_pattern": "\\b(ui|ux|interface|page|screen|layout|design|palette|component|frontend|accessib\\w*)\\b"
    },
    "architecture": {
      "skill_pattern": "\\b(architect\\w*|adr|system design|tech(nical)? spec|design doc\\w*|c4 model|module boundar\\w*|api design|trade-?offs?|low-?code|no-?code)\\b",
      "task_pattern": "\\b(apps?|applications?|service|api|system|architect\\w*|backend|database|platform|low-?code|no-?code|pro-?code|power (apps|automate))\\b"
    },
    "de-slop": {
      "skill_pattern": "\\b(de-?slop\\w*|slop|over-?engineer\\w*|overcomplicat\\w*|simplif\\w*|simplicity|surgical|dead code|bloat\\w*|verbos\\w*)\\b",
      "task_pattern": "\\b(clean ?up|simplif\\w*|refactor\\w*|review\\w*|polish\\w*|slop|bloat\\w*|readab\\w*|tidy|copy|wording)\\b"
    },
    "scrub": {
