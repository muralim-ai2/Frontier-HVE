{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontier HVE deliverable template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enforce", "templates"],
  "properties": {
    "version": {"const": 1},
    "enforce": {"type": "boolean"},
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prd", "technicalDesign", "testStrategy"],
      "properties": {
        "prd": {"$ref": "#/$defs/entry"},
        "technicalDesign": {"$ref": "#/$defs/entry"},
        "testStrategy": {"$ref": "#/$defs/entry"}
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "output"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "output": {"type": "string", "pattern": "^[^{}]*\\{slug\\}[^{}]*\\.md$"}
      }
    }
  }
}