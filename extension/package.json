{
  "name": "frontier-hve",
  "displayName": "Frontier HVE",
  "description": "Enterprise AI harness for GitHub Copilot: HVE agents with a verified feature loop, graph workflow, guards and human-ticked PRs.",
  "version": "0.21.0",
  "publisher": "muralim-ai2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/muralim-ai2/Frontier-HVE"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["AI", "Chat"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "frontierHve", "title": "Frontier HVE", "icon": "ui/media/hve.svg" }]
    },
    "views": {
      "frontierHve": [
        { "type": "webview", "id": "frontierHve.missionControl", "name": "Mission Control" },
        { "id": "frontierHve.harnessFiles", "name": "Harness files" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "frontierHve.harnessFiles",
        "contents": "No .hve/ or .harness/ folder in this workspace yet. Asks, plans, evidence, run records and loop files appear here as soon as an agent or the harness writes them.\n[New ask](command:frontierHve.newAsk)"
      }
    ],
    "commands": [
      {
        "command": "frontierHve.setup",
        "title": "Frontier HVE: Set up"
      },
      {
        "command": "frontierHve.installHarnesses",
        "title": "Frontier HVE: Install for other harnesses (Copilot CLI, Claude, Codex, Cursor, cloud agent)"
      },
      {
        "command": "frontierHve.researchTelemetry",
        "title": "Frontier HVE: Turn on research telemetry (benchmarks only)"
      },
      {
        "command": "frontierHve.researchTelemetryOff",
        "title": "Frontier HVE: Turn off research telemetry"
      },
      {
        "command": "frontierHve.installPlugin",
        "title": "Frontier HVE: Install plugin (expertise pack)"
      },
      {
        "command": "frontierHve.managePlugins",
        "title": "Frontier HVE: Manage plugins (expertise packs)"
      },
      {
        "command": "frontierHve.openMissionControl",
        "title": "Frontier HVE: Open Mission Control"
      },
      {
        "command": "frontierHve.refreshMissionControl",
        "title": "Frontier HVE: Refresh Mission Control"
      },
      {
        "command": "frontierHve.selectWorkspace",
        "title": "Frontier HVE: Select Mission Control workspace"
      },
      {
        "command": "frontierHve.newAsk",
        "title": "Frontier HVE: New ask"
      },
      {
        "command": "frontierHve.editPlan",
        "title": "Frontier HVE: Edit plan"
      }
    ],
    "configuration": {
      "title": "Frontier HVE",
      "properties": {
        "frontierHve.pluginIndex": {
          "type": "string",
          "default": "",
          "description": "Organization expertise pack index (path or https URL) that lists approved packs, versions, hashes and revocations."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test:release": "npm run check && node ../tests/mission-control/release.js"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "@azure/msal-node": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
